# MySQL connection: mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/aventra"

# Public address of the site, no trailing slash (used for SEO tags and the sitemap)
SITE_URL="http://localhost:3000"

# Default admin, created automatically while the users table is empty (and by npm run db:seed).
# Change the password after the first login, and always before going live.
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="password"

# Folder for uploaded photos and CVs (keep it outside the build output)
STORAGE_DIR="./storage"

# Email for contact-form notifications (optional; messages are always saved to the inbox)
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="Aventra Website <onboarding@resend.dev>"
